<Window x:Class="Course_Pilot.Views.ClassDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Course_Pilot.Views"
        mc:Ignorable="d"
        Title="Class Details" Height="637" Width="1159">


    <Grid Margin="20">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="8.25"/>
            <ColumnDefinition Width="591.75"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,71" Grid.RowSpan="2">
            <TextBlock
            Text="{Binding CourseCode}"
            FontSize="26"
            FontWeight="Bold"/>

            <TextBlock
            Text="{Binding CourseTitle}"
            FontSize="18"
            Margin="0,3,0,15"/>

            <TextBlock
            Text="Exams"
            FontSize="22"
            FontWeight="SemiBold"
            Margin="0,0,0,10"/>
        </StackPanel>

        <!--EXAMS-->
        <ScrollViewer Grid.Row="1"
                      Grid.Column="0"
                  VerticalScrollBarVisibility="Auto" Grid.ColumnSpan="2">
            <ItemsControl ItemsSource="{Binding Exams}" 
                          HorizontalAlignment="Left">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border
                        Background="#F0FFF0"
                        BorderBrush="LightGray"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12"
                        Margin="0,0,0,10"
                        Width="600">

                            <StackPanel>
                                <TextBlock
                                Text="{Binding Name}"
                                FontSize="18"
                                FontWeight="Bold"/>

                                <TextBlock
                                Text="{Binding Date, StringFormat=Date: {0}}"
                                Margin="0,5,0,0"/>

                                <TextBlock
                                Text="{Binding Time, StringFormat=Time: {0}}"/>

                                <TextBlock
                                Text="{Binding Coverage, StringFormat=Coverage: {0}}"
                                TextWrapping="Wrap"
                                Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!--USEFUL RESOURCES-->
        <Border BorderBrush="#DDDDDD"
        Background="#EAF4FF"
        BorderThickness="1"
        CornerRadius="8"
        Padding="15"
        Margin="0,20,0,0"
        Grid.Row="2"
        Grid.Column ="0" 
        Grid.ColumnSpan="2">

            <Grid Margin="10,20,10,0">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">

                    <TextBlock 
                    Text="Useful Resources"
                    FontSize="22"
                    FontWeight="Bold"
                    Margin="0,0,35,0"/>
                    <!--CLEAR BUTTON-->
                    <Button x:Name="ClearResourcesButton"
                    Content="✕"
                    Width="24"
                    Height="24"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Visibility="Collapsed"
                    Click="ClearResourcesButton_Click"/>

                </Grid>

                <Button x:Name="GenerateResourcesButton"
                Cursor="Hand"
                Content="Generate Helpful Resources"
                Width="250"
                Height="40"
                HorizontalAlignment="Left"
                Click="GenerateResourcesButton_Click"
                Grid.Row="1"
                VerticalAlignment="Top"
                Margin="0,10,0,0"/>



                <ScrollViewer 
                x:Name="ResourcesScrollViewer"
                Visibility="Collapsed"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                Height="430"
                Margin="0,15,0,0"
                Grid.Row="1">

                    <StackPanel x:Name="ResourcesPanel"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <!--GRADE WEIGHTS -->
        <StackPanel Grid.Row="1"
            Grid.Column="2"
            Margin="20,0,0,0"
            VerticalAlignment="Center">

            <TextBlock Text="Grade Weights"
               FontSize="22"
               FontWeight="SemiBold"
               Margin="0,0,0,10"/>

            <Border Background="#ffddee"
            BorderBrush="LightGray"
            BorderThickness="1"
            CornerRadius="8"
            Padding="15">

                <ItemsControl ItemsSource="{Binding GradeWeights}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{Binding Category}"
                                   FontSize="16"/>

                                <TextBlock Grid.Column="1"
                                   Text="{Binding Weight}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Margin="20,0,0,0"/>

                            </Grid>

                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>

        <!-- INFORMATION FOR USER -->
        <Border Grid.Column="2"
        Grid.Row="2"
        Margin="20,100,0,0"
        Padding="20"
        Background="#FFF8D6"
        BorderBrush="#D6C86E"
        BorderThickness="1"
        CornerRadius="10"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Top"
        MaxWidth="500">

            <StackPanel>

                <TextBlock Text="About This Screen"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,12"/>

                <TextBlock FontSize="14"
                   Foreground="#333333"
                   TextWrapping="Wrap"
                   LineHeight="21"
                   Text="This screen gives you a complete overview of your course. You can review upcoming exams, view grade weights, and generate helpful study resources based on information found in your syllabus."/>

                <TextBlock FontSize="14"
                   Foreground="#333333"
                   TextWrapping="Wrap"
                   LineHeight="21"
                   Margin="0,12,0,0"
                   Text="The Helpful Resources section can provide relevant websites, videos, and other study materials for the course."/>

                <TextBlock FontSize="13"
                   Foreground="#666666"
                   FontStyle="Italic"
                   TextWrapping="Wrap"
                   Margin="0,12,0,0"
                   Text="Additional course-planning features will be included in future updates."/>

            </StackPanel>

        </Border>
    </Grid>
</Window>
